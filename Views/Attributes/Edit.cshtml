@model CvManagementSystem.Models.AttributeDefinition
@{ ViewData["Title"] = "Edit Attribute"; }

<h3>Edit Attribute</h3>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3" style="max-width:600px">
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="version" value="@Model.Version" />

    <div class="col-12">
        <label class="form-label">Name</label>
        <input class="form-control" name="Name" value="@Model.Name" @(Model.IsBuiltIn ? "readonly" : "") required />
    </div>
    <div class="col-6">
        <label class="form-label">Category</label>
        <select class="form-select" name="Category">
            @foreach (var c in Enum.GetValues<CvManagementSystem.Models.AttributeCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@DisplayFormat.Humanize(c)</option>
            }
        </select>
    </div>
    <div class="col-6">
        <label class="form-label">Type</label>
        <input class="form-control" value="@Model.Type" readonly />
        <div class="form-text">Type can't change after creation — CVs already reference it by shape.</div>
    </div>
    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="2">@Model.Description</textarea>
    </div>

    <div class="col-12">
        <button class="btn btn-primary">Save changes</button>
        @if (!Model.IsBuiltIn)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete this attribute? It will be removed from all positions and profiles using it.')">
                <button class="btn btn-outline-danger">Delete</button>
            </form>
        }
    </div>
</form>
