@model List<CvManagementSystem.Models.ApplicationUser>
@inject Microsoft.Extensions.Localization.IStringLocalizer<CvManagementSystem.SharedResource> Localizer
@{ ViewData["Title"] = "User Management"; var roles = (Dictionary<string, IList<string>>)ViewBag.Roles; }

<h3>@Localizer["UserManagement"]</h3>

<form asp-action="BulkAction" method="post" id="bulkForm">
    <div class="mb-2 d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" name="action" value="block">@Localizer["BlockSelected"]</button>
        <button class="btn btn-outline-secondary btn-sm" name="action" value="unblock">@Localizer["UnblockSelected"]</button>
        <button class="btn btn-outline-danger btn-sm" name="action" value="delete"
                onclick="return confirm('Permanently delete selected users?')">@Localizer["DeleteSelected"]</button>
        <span class="vr"></span>
        <select class="form-select form-select-sm" name="role" style="width:auto" id="roleSelect">
            <option value="Candidate">Candidate</option>
            <option value="Recruiter">Recruiter</option>
            <option value="Administrator">Administrator</option>
        </select>
        <button class="btn btn-outline-primary btn-sm" name="action" value="addrole">Add role to selected</button>
        <button class="btn btn-outline-warning btn-sm" name="action" value="removerole"
                onclick="return confirm('Remove this role from the selected users? (Admins may remove their own Administrator role.)')">
            Remove role from selected
        </button>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr><th><input type="checkbox" id="selectAll" /></th><th>@Localizer["Email"]</th><th>@Localizer["Roles"]</th><th>@Localizer["Status"]</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td><input type="checkbox" name="userIds" value="@u.Id" /></td>
                <td>@u.Email</td>
                <td>@string.Join(", ", roles.GetValueOrDefault(u.Id) ?? new List<string>())</td>
                <td>@(u.IsBlocked ? "Blocked" : "Active")</td>
            </tr>
        }
        </tbody>
    </table>
</form>

@section Scripts {
<script>
    document.getElementById('selectAll')?.addEventListener('change', function () {
        document.querySelectorAll('input[name=userIds]').forEach(c => c.checked = this.checked);
    });
</script>
}
