@{ ViewData["Title"] = "Register"; }
@inject Microsoft.Extensions.Localization.IStringLocalizer<CvManagementSystem.SharedResource> Localizer
<div class="row justify-content-center">
    <div class="col-12 col-md-5">
        <h3>@Localizer["RegisterTitle"]</h3>
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Register" method="post">
            <div class="mb-3"><label class="form-label">@Localizer["FirstName"]</label><input class="form-control" name="firstName" required /></div>
            <div class="mb-3"><label class="form-label">@Localizer["LastName"]</label><input class="form-control" name="lastName" required /></div>
            <div class="mb-3"><label class="form-label">@Localizer["Email"]</label><input class="form-control" name="email" type="email" required /></div>
            <div class="mb-3"><label class="form-label">@Localizer["Password"]</label><input class="form-control" name="password" type="password" required minlength="8" /></div>
            <button class="btn btn-primary w-100">@Localizer["RegisterTitle"]</button>
        </form>
        <p class="mt-3">Already have an account? <a asp-action="Login">@Localizer["LoginTitle"]</a></p>
    </div>
</div>
