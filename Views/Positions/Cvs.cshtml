@model List<CvManagementSystem.Models.Cv>
@{ ViewData["Title"] = "CVs for position"; }

<h3>Submitted CVs</h3>
<table class="table table-hover align-middle">
    <thead><tr><th>Candidate</th><th>Likes</th><th>Updated</th></tr></thead>
    <tbody>
    @foreach (var cv in Model)
    {
        <tr onclick="location.href='@Url.Action("Details", "Cv", new { id = cv.Id })'" style="cursor:pointer">
            <td>@cv.Candidate.FirstName @cv.Candidate.LastName</td>
            <td>@cv.Likes.Count</td>
            <td>@cv.UpdatedAt.ToString("yyyy-MM-dd")</td>
        </tr>
    }
    </tbody>
</table>
