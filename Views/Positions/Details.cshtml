@model CvManagementSystem.Models.Position
@inject Microsoft.AspNetCore.Identity.SignInManager<CvManagementSystem.Models.ApplicationUser> SignInManager
@{ ViewData["Title"] = Model.Title; }
<div class="d-flex justify-content-between align-items-start">
    <div>
        <h3>@Model.Title</h3>
        <p class="text-muted">@Model.ShortDescription</p>
    </div>
    <div>
        @if (User.IsInRole("Candidate"))
        {
            <form asp-controller="Cv" asp-action="Create" method="post" class="d-inline">
                <input type="hidden" name="positionId" value="@Model.Id" />
                <button class="btn btn-primary btn-sm">Create / Open my CV</button>
            </form>
        }
        @if (User.IsInRole("Recruiter") || User.IsInRole("Administrator"))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Cvs" asp-route-id="@Model.Id">View CVs</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCvs" asp-route-id="@Model.Id">Export</a>
        }
    </div>
</div>

<ul class="nav nav-tabs my-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-attrs">Attributes</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-discussion">Discussion</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-attrs">
        <table class="table">
            <thead><tr><th>Attribute</th><th>Type</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Attributes.OrderBy(a => a.SortOrder))
            {
                <tr><td>@a.AttributeDefinition.Name</td><td>@a.AttributeDefinition.Type</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="tab-pane fade" id="tab-discussion">
        <div id="discussionList" class="mb-3">
        @foreach (var post in Model.DiscussionPosts.OrderBy(p => p.CreatedAt))
        {
            <div class="border-bottom py-2">
                <div class="fw-semibold">
                    @if (User.IsInRole("Recruiter"))
                    {
                        <a asp-controller="Profile" asp-action="Index" asp-route-id="@post.AuthorId">@post.Author.FirstName @post.Author.LastName</a>
                    }
                    else
                    {
                        @($"{post.Author.FirstName} {post.Author.LastName}")
                    }
                    <span class="text-muted small ms-2">@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div>@Html.Raw(Markdig.Markdown.ToHtml(post.ContentMarkdown))</div>
            </div>
        }
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
        <form id="discussionForm" class="d-flex gap-2">
            <input type="hidden" id="positionId" value="@Model.Id" />
            <textarea class="form-control" id="postContent" rows="2" placeholder="Write a message (Markdown supported)…"></textarea>
            <button class="btn btn-primary" type="submit">Post</button>
        </form>
        }
        else
        {
        <div class="text-muted small">Log in to join the discussion.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    const positionId = document.getElementById('positionId').value;
    const list = document.getElementById('discussionList');
    const token = document.querySelector('input[name=__RequestVerificationToken]')?.value;

    connectDiscussion(positionId, post => {
       
        const div = document.createElement('div');
        div.className = 'border-bottom py-2';
        div.innerHTML = `<div class="fw-semibold">${post.authorName}
            <span class="text-muted small ms-2">${new Date(post.timestamp).toLocaleString()}</span></div>
            <div>${post.html}</div>`;
        list.appendChild(div);
    });

    document.getElementById('discussionForm').addEventListener('submit', async e => {
        e.preventDefault();
        const content = document.getElementById('postContent').value;
        if (!content.trim()) return;
        await fetch('/Discussion/Post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: `positionId=${positionId}&content=${encodeURIComponent(content)}`
        });
        document.getElementById('postContent').value = '';
    });
</script>
}
